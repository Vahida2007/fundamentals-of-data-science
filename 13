import pandas as pd

data = pd.read_csv("stock_data.csv")

prices = data['Close']

print("Mean:", prices.mean())
print("Variance:", prices.var())
print("Standard Deviation:", prices.std())
print("Minimum:", prices.min())
print("Maximum:", prices.max())
print("Range:", prices.max() - prices.min())
