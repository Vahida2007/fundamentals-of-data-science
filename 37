import numpy as np
from sklearn.cluster import KMeans

X = np.array([
    [1000, 5],
    [1200, 6],
    [1100, 5],
    [5000, 20],
    [5500, 22],
    [5200, 21],
    [10000, 40],
    [11000, 45],
    [10500, 42]
])

model = KMeans(n_clusters=3, random_state=42, n_init=10)
model.fit(X)

spending = float(input("Enter total spending: "))
visits = float(input("Enter number of visits: "))

cluster = model.predict([[spending, visits]])

print("Customer belongs to Cluster:", cluster[0])
