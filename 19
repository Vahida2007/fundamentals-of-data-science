import pandas as pd
from collections import Counter
import re

data = pd.DataFrame({
    'Review': [
        'good product and good quality',
        'excellent product',
        'good quality product'
    ]
})

text = ' '.join(data['Review']).lower()

words = re.findall(r'\b\w+\b', text)

frequency = Counter(words)

print(frequency)
