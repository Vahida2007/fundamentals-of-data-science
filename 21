import pandas as pd
import matplotlib.pyplot as plt
import scipy.stats as stats

data = {
    'Age': [23, 25, 31, 35, 29, 42, 37, 28, 45, 33, 26, 39, 41, 30, 27, 36, 48, 32],
    'Fat': [18.2, 20.5, 22.1, 25.3, 21.4, 28.5, 26.2, 19.8, 30.1,
            24.5, 20.2, 27.1, 29.4, 23.3, 19.5, 25.8, 31.2, 22.8]
}

df = pd.DataFrame(data)

print("Mean:")
print(df.mean())

print("\nMedian:")
print(df.median())

print("\nStandard Deviation:")
print(df.std())

# Boxplots
df.boxplot(column=['Age', 'Fat'])
plt.title("Boxplot of Age and Body Fat")
plt.show()

# Scatter plot
plt.scatter(df['Age'], df['Fat'])
plt.xlabel("Age")
plt.ylabel("Body Fat %")
plt.title("Age vs Body Fat")
plt.show()

# Q-Q plots
stats.probplot(df['Age'], dist="norm", plot=plt)
plt.title("Q-Q Plot of Age")
plt.show()

stats.probplot(df['Fat'], dist="norm", plot=plt)
plt.title("Q-Q Plot of Body Fat")
plt.show()
