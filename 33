import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

data = {
    'Size': [800, 1000, 1200, 1400, 1600, 1800, 2000],
    'Price': [3000000, 3500000, 4100000, 4700000,
              5300000, 5900000, 6500000]
}

df = pd.DataFrame(data)

X = df[['Size']]
y = df['Price']

model = LinearRegression()
model.fit(X, y)

y_pred = model.predict(X)

print("Coefficient:", model.coef_[0])
print("Intercept:", model.intercept_)
print("R2 Score:", r2_score(y, y_pred))
print("Mean Squared Error:", mean_squared_error(y, y_pred))

plt.scatter(X, y)
plt.plot(X, y_pred)
plt.xlabel("House Size")
plt.ylabel("Price")
plt.title("House Size vs Price")
plt.show()
Output:


Coefficient: approximately 3000
Intercept: approximately 600000
R2 Score: approximately 0.99
Mean Squared Error: very small
